BEGIN
	OUTPUT BLUE;
	OUTPUT "Black Finger Eliminator"
	OUTPUT NEWLINE;
	OUTPUT MAGENTA;
	OUTPUT "(C) Copyright 2026 Larry B. Daniel, Atlanta Ga."
	OUTPUT NEWLINE;
	OUTPUT CLEAR;

	INTEGER RND;
	INTEGER ACCUMULATOR;
	INTEGER APPLY;

	INTEGER OUT;
	OUT := 25000;

	INTEGER BLACKISHFINGER; 
	BLACKISHFINGER := 214;
 
	INTEGER FAITH;
	FAITH := 61;
	INTEGER NEWT;
	NEWT := 50;

S0:	YIELD;
	ACCUMULATOR := 0;

S1:	YIELD;
	
	RND := RANDOM;
	RND := ROOT;

	IF ACCUMULATOR = 2 THEN JUMP S2; 
	IF ACCUMULATOR = 21 THEN JUMP S3; 
	IF RND = 2 THEN	ACCUMULATOR := 2;
	JUMP S1;

S2:	YIELD;	
	IF RND = 1 THEN ACCUMULATOR := 21;
	JUMP S1;

S3:	YIELD;	
	IF RND = 4 THEN ACCUMULATOR := BLACKISHFINGER;

	IF ACCUMULATOR = BLACKISHFINGER THEN 
	BEGIN
                INTEGER CASE;
                CASE := 0;
S4:             APPLY := 0;
                TIMED OUT ;
                IF CASE = 0 THEN APPLY := FAITH;
                IF CASE = 1 THEN APPLY := BLACKISHFINGER;
                IF CASE = 2 THEN APPLY := NEWT;
                IF CASE = 3 THEN APPLY := FAITH;
	        TIMED OUT ;
                APPLY := 0;
                TIMED OUT ;
                ACCUMULATOR := 0;
                CASE := CASE + 1 ;
		IF CASE < 4 THEN JUMP S4;
	END
	JUMP S1;
END